# Copy to .env and fill in. .env is gitignored.

# --- Input --------------------------------------------------------------
GRADES_FILE=Calculus_Grades_AY2526_2nd_sem.xlsx
GRADES_SHEET=Main
OUTPUT_DIR=output
# Where the numbers in the emails come from: python (policy in grading.py,
# default) or excel (the workbook's Final Grade / Equiv columns).
GRADE_SOURCE=python

# --- Sending ------------------------------------------------------------
# Gmail account used to send grade emails
SENDER_EMAIL=you@example.com
# Gmail App Password (not your account password): https://myaccount.google.com/apppasswords
APP_PASSWORD=xxxx xxxx xxxx xxxx
# Name shown in the email signature
SENDER_NAME=Your Name
# When TEST_MODE=true, every email goes to TEST_EMAIL instead of the student.
# Set to false only for the real send.
TEST_MODE=true
TEST_EMAIL=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Email content ------------------------------------------------------
COURSE_NAME=Calculus
EMAIL_SUBJECT=Calculus Final Grade
CLARIFICATION_DEADLINE=June 8, 2026
EXAM_REVIEW_SCHEDULE=June 8, 2026 (Monday), from 11:00 AM to 2:00 PM
CRS_UPLOAD_DATE=June 9, 2026
